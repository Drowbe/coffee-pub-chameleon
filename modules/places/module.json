{
  "id": "places",
  "name": "Places",
  "version": "0.12.19",
  "icon": "location-dot",
  "color": "orange",
  "description": "The places your {space} cares about: where to stay, where to eat, what to see. Other {modules} link to them, and a place with a position shows on the map.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space",
    "person"
  ],
  "surfaces": {
    "destination": [
      { "id": "map", "part": "panel", "entry": "page.html" }
    ],
    "page": {
      "entry": "page.html",
      "nav": false
    },
    "canvas": {
      "entry": "canvas.html",
      "width": 460,
      "height": 600,
      "mode": [
        "dock",
        "float"
      ]
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See places",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add, change and remove places",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "actions": {
    "provides": [
      {
        "name": "addPlace",
        "label": "Save it as a place",
        "needs": [
          "place"
        ],
        "input": {
          "title": "string",
          "lat": "number?",
          "lng": "number?",
          "address": "string?",
          "category": "string?",
          "notes": "text?",
          "ref": "ref?",
          "in": "string?"
        }
      },
      {
        "name": "sharePlace",
        "label": "Share a place",
        "local": true,
        "input": {
          "place": "ref:places:place",
          "in": "string?"
        }
      },
      {
        "name": "setPlacePoint",
        "label": "Give a place a position",
        "input": {
          "place": "ref:places:place",
          "lat": "number",
          "lng": "number"
        }
      },
      {
        "name": "searchPlaces",
        "label": "Search for a place",
        "local": true,
        "input": {
          "q": "string",
          "lat": "number?",
          "lon": "number?"
        }
      },
      {
        "name": "positionPicked",
        "label": "Set the position of the place being added",
        "local": true,
        "input": {
          "lat": "number?",
          "lng": "number?",
          "page": "string?",
          "pageUntil": "number?"
        }
      },
      {
        "name": "categoryColors",
        "label": "Tell the colours chosen for categories",
        "local": true,
        "input": {
          "page": "string?",
          "pageUntil": "number?"
        }
      },
      {
        "name": "mayAdd",
        "label": "Tell whether this person may add places",
        "local": true,
        "input": {
          "page": "string?",
          "pageUntil": "number?"
        }
      },
      {
        "name": "newPlace",
        "label": "Save a place here",
        "local": true,
        "input": {
          "origin": "string?",
          "title": "string?",
          "lat": "number?",
          "lng": "number?",
          "address": "string?",
          "notes": "text?"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "refs": {
    "produces": [
      {
        "kind": "place",
        "name": "Place",
        "open": true,
        "backlinks": true,
        "key": "place:{id}",
        "summary": {
          "title": "title",
          "subtitle": "address",
          "place": "point",
          "category": "category",
          "icon": "icon",
          "visit": "status",
          "color": "color",
          "spaces": "spaces"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  },
  "geocoder": {
    "provider": "searchProvider",
    "address": "search",
    "save": "saveResults",
    "custom": "custom",
    "providers": {
      "photon": {
        "name": "Photon",
        "address": "https://photon.komoot.io/api",
        "credit": "Search by Photon · © OpenStreetMap contributors"
      }
    }
  },
  "settings": [
    {
      "key": "categories",
      "label": "Categories",
      "type": "list",
      "scope": "environment",
      "maxLength": 30,
      "fixed": [
        "other"
      ],
      "help": "How places are grouped and coloured, in this order. Other is always there and holds any place whose category is not on the list; you can rename it but not remove it. Taking a category off the list removes no place and no type: its places show under Other, and its types stay in the picker. Grey keeps the automatic colour.",
      "default": [
        { "id": "food", "label": "Food & Drink", "icon": "utensils", "color": "#888888" },
        { "id": "stay", "label": "Accommodations", "icon": "bed", "color": "#888888" },
        { "id": "sights", "label": "Sights & Culture", "icon": "landmark", "color": "#888888" },
        { "id": "nature", "label": "Nature & Outdoors", "icon": "tree", "color": "#888888" },
        { "id": "activities", "label": "Activities & Experiences", "icon": "ticket", "color": "#888888" },
        { "id": "nightlife", "label": "Entertainment & Nightlife", "icon": "masks-theater", "color": "#888888" },
        { "id": "shopping", "label": "Shopping", "icon": "bag-shopping", "color": "#888888" },
        { "id": "transport", "label": "Transportation", "icon": "train", "color": "#888888" },
        { "id": "services", "label": "Services & Essentials", "icon": "circle-info", "color": "#888888" },
        { "id": "health", "label": "Health & Wellness", "icon": "heart-pulse", "color": "#888888" },
        { "id": "other", "label": "Personal & Other", "icon": "location-dot", "color": "#888888" }
      ]
    },
    {
      "key": "searchProvider",
      "label": "Place search",
      "type": "choice",
      "scope": "environment",
      "default": "none",
      "defaultIfSet": {
        "key": "search",
        "value": "custom"
      },
      "help": "Where a search for a place by name is asked. The server sends nothing out unless you choose one.",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "photon",
          "label": "Photon, the public service",
          "help": "Every search is sent to the public Photon service at photon.komoot.io, and the server otherwise sends nothing out.\nTheir terms are \"reasonable limits\": extensive use may be throttled or banned, and there is no availability guarantee (https://github.com/komoot/photon).\nResults come from OpenStreetMap data, so \"© OpenStreetMap contributors\" applies (the map already shows that credit)."
        },
        {
          "value": "custom",
          "label": "My own address",
          "help": "Searches go to the address you give below: a Photon-compatible service you run or may use."
        }
      ]
    },
    {
      "key": "search",
      "label": "Search address",
      "type": "url",
      "scope": "environment",
      "default": "",
      "showWhen": {
        "key": "searchProvider",
        "value": "custom"
      },
      "help": "A Photon-compatible place search that you run or may use, over https (for example https://search.example.org/api)."
    },
    {
      "key": "saveResults",
      "label": "Save places in this {environment}",
      "type": "boolean",
      "scope": "environment",
      "default": false,
      "showWhen": {
        "key": "searchProvider",
        "not": "none"
      },
      "help": "Places a search returns are saved in this {environment} and shared by every {space}, so later searches use them first and the outside service is asked less. Only the place is kept, never who looked for it."
    }
  ]
}
