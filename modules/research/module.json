{
  "id": "research",
  "name": "Research",
  "version": "0.4.28",
  "icon": "book-open",
  "color": "blue",
  "description": "What a group finds out while it plans: notes, links with the part that mattered, photos with a caption. Tagged, searchable, linkable from anywhere, and questioned or summarised by the AI the {owner} chose.",
  "author": "Coffee Pub",
  "scope": [
    "space",
    "person"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html"
    },
    "canvas": {
      "entry": "canvas.html",
      "width": 520,
      "height": 640,
      "mode": [
        "dock",
        "float"
      ]
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See research",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add, change and remove research",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    },
    {
      "key": "remove_photos",
      "label": "Remove photos other people added",
      "default": {
        "member": false,
        "guest": false,
        "moderator": false
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit",
    "personWrite": "view"
  },
  "guards": {
    "clear": "remove_photos",
    "exclusive": ["note:{id}", "link:{id}", "photo:{id}", "answer:{id}"],
    "keys": [
      {
        "key": "photo:{id}",
        "owner": "by",
        "file": "file",
        "others": {
          "change": "remove_photos",
          "delete": "remove_photos",
          "may": ["title", "tags", "date", "point", "text", "sub", "at"]
        }
      }
    ]
  },
  "hooks": {
    "ai": "optional"
  },
  "uploads": {
    "types": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "maxBytes": 10485760,
    "maxFiles": 500
  },
  "refs": {
    "produces": [
      {
        "kind": "note",
        "name": "Note",
        "open": true,
        "backlinks": true,
        "key": "note:{id}",
        "summary": {
          "title": "title",
          "subtitle": "sub",
          "when": "date",
          "place": "point",
          "category": "kind",
          "text": "text"
        }
      },
      {
        "kind": "link",
        "name": "Link",
        "open": true,
        "backlinks": true,
        "key": "link:{id}",
        "summary": {
          "title": "title",
          "subtitle": "sub",
          "when": "date",
          "place": "point",
          "category": "kind",
          "text": "text"
        }
      },
      {
        "kind": "photo",
        "name": "Photo",
        "open": true,
        "backlinks": true,
        "key": "photo:{id}",
        "summary": {
          "title": "title",
          "subtitle": "sub",
          "when": "date",
          "place": "point",
          "category": "kind",
          "text": "text"
        }
      },
      {
        "kind": "answer",
        "name": "Answer",
        "open": true,
        "backlinks": true,
        "key": "answer:{id}",
        "summary": {
          "title": "title",
          "subtitle": "sub",
          "when": "date",
          "place": "point",
          "category": "kind",
          "text": "text"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  },
  "actions": {
    "provides": [
      {
        "name": "saveNote",
        "label": "Save it to research",
        "input": {
          "title": "string",
          "body": "text?",
          "tags": "string?",
          "icon": "string?",
          "kind": "string?",
          "ref": "ref?",
          "object": "object?"
        },
        "takes": [
          { "kinds": ["note", "*", "text"], "as": "a note" }
        ]
      },
      {
        "name": "saveLink",
        "label": "Save this link to research",
        "input": {
          "url": "text",
          "title": "string?",
          "excerpt": "text?",
          "ref": "ref?",
          "object": "object?"
        },
        "takes": [
          { "kinds": ["link"], "as": "a link" }
        ]
      },
      {
        "name": "savePhoto",
        "label": "Save this picture to research",
        "input": {
          "object": "object"
        },
        "takes": [
          { "kinds": ["image"], "as": "an image" }
        ]
      },
      {
        "name": "addNote",
        "label": "Add a research note",
        "local": true,
        "input": {
          "text": "string"
        }
      },
      {
        "name": "addLink",
        "label": "Add a research link",
        "local": true,
        "input": {
          "text": "string"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "commands": [
    { "name": "n", "word": "note", "label": "Add a research note", "action": "addNote", "hint": "the note's text" },
    { "name": "l", "word": "link", "label": "Add a research link", "action": "addLink", "hint": "the web address" }
  ],
  "settings": [
    {
      "key": "tags",
      "label": "Well-known tags",
      "type": "list",
      "scope": "environment",
      "maxLength": 30,
      "fixed": [],
      "help": "Tags with a colour, shared by everyone. A tag that is on this list wears its colour; any other tag stays plain.",
      "default": []
    },
    {
      "key": "linkPreviews",
      "label": "Fetch link previews",
      "type": "boolean",
      "scope": "environment",
      "default": true,
      "help": "When someone adds a link, this server reads that page for its title, description and image, and fills in an empty title or description. The link shows the picture and that description. Off, nothing is fetched. The request goes from this server to the address they typed."
    }
  ]
}
