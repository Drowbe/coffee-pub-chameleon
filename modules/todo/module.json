{
  "id": "todo",
  "name": "To-do",
  "version": "1.15.30",
  "icon": "list-check",
  "color": "green",
  "description": "A shared to-do list for the whole {environment} and for each {space}, with due dates and reminders.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space"
  ],
  "surfaces": {
    "destination": [
      { "id": "calendar", "part": "panel", "entry": "page.html", "label": "To-do", "order": 20, "showWhenSetting": "inCalendar" }
    ],
    "page": {
      "entry": "page.html"
    },
    "canvas": {
      "entry": "canvas.html",
      "width": 380,
      "height": 540,
      "mode": [
        "dock",
        "float"
      ]
    },
    "widget": {
      "entry": "widget.html",
      "title": "Due soon",
      "size": "small",
      "order": 20
    }
  },
  "settings": [
    {
      "key": "inCalendar",
      "label": "Show in the Calendar",
      "type": "boolean",
      "scope": "environment",
      "default": true,
      "needsModule": "calendar",
      "help": "The list also appears in the Calendar's side panel. Dated tasks stay on the Calendar's days either way."
    }
  ],
  "permissions": [
    {
      "key": "view",
      "label": "See the to-do list",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add, change and tick off tasks",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "hooks": {
    "schedule": true,
    "notify": true
  },
  "events": {
    "subscribes": [
      "*"
    ]
  },
  "actions": {
    "provides": [
      {
        "name": "createTask",
        "label": "Add a task",
        "description": "Add a new task.",
        "effect": "write",
        "input": {
          "title": "string",
          "notes": "text?",
          "ref": "ref?",
          "due": "date?",
          "object": "object?"
        },
        "takes": [
          { "kinds": ["task", "*", "text"], "as": "a task" }
        ]
      },
      {
        "name": "linkTask",
        "label": "Link this task to it",
        "description": "Link a task to another {object} it is about, so each shows the other.",
        "effect": "write",
        "input": {
          "task": "ref:todo:task",
          "target": "ref"
        }
      },
      {
        "name": "setTaskDue",
        "label": "Set this task's due date to its date",
        "description": "Set a task's due date.",
        "effect": "write",
        "input": {
          "task": "ref:todo:task",
          "date": "date"
        }
      },
      {
        "name": "addTask",
        "label": "Add a task",
        "local": true,
        "input": {
          "text": "string"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "commands": [
    { "name": "t", "word": "todo", "label": "Add a to-do", "action": "addTask", "hint": "the to-do" }
  ],
  "refs": {
    "produces": [
      {
        "kind": "task",
        "name": "Task",
        "open": true,
        "key": "task:{id}",
        "summary": {
          "title": "title",
          "subtitle": "notes",
          "when": "due",
          "done": "done"
        },
        "dated": { "title": "title", "day": "due" },
        "marker": true
      }
    ],
    "consumes": [
      "*"
    ]
  }
}
